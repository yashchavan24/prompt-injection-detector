{
  "manifest_version": 3,
  "name": "Prompt Injection Guard",
  "version": "2.0",
  "description": "Screens prompts for injection attacks before sending to ANY AI chatbot: ChatGPT, Claude, Gemini, Qwen, DeepSeek, Copilot, Mistral, Grok.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "https://prompt-injection-detector-nine.vercel.app/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://aistudio.google.com/*",
    "https://chat.qwen.ai/*",
    "https://chat.deepseek.com/*",
    "https://chat.mistral.ai/*",
    "https://copilot.microsoft.com/*",
    "https://grok.com/*",
    "https://x.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://aistudio.google.com/*",
        "https://chat.qwen.ai/*",
        "https://chat.deepseek.com/*",
        "https://chat.mistral.ai/*",
        "https://copilot.microsoft.com/*",
        "https://grok.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ]
}
